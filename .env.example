# Copy this file to .env before running docker compose.
TZ=Asia/Shanghai

# Git source pulled during Docker image build.
GIT_REPOSITORY=https://github.com/duzqiu/scrapy_news_crawler.git
GIT_REF=main

# PostgreSQL used by the FastAPI backend.
PG_HOST=192.168.31.201
PG_PORT=5452
PG_DATABASE=admin_db
PG_USER=postgres
PG_PASSWORD=123456
PG_CONNECT_TIMEOUT=10

# Redis URL de-duplicates article URLs before insertion.
REDIS_URL=redis://192.168.31.201:6379/0
REDIS_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=10
REDIS_DEDUPE_TTL=2592000
